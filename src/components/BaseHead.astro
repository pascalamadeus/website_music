
---
import "../styles/global.css";
import { AstroSeo } from "@lexingtonthemes/seo";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Pascal Vorwerk",
  url: "https://www.pascal-vorwerk.de/",
  jobTitle: "Guitarist & Musician",
  description:
    "Pascal Vorwerk is a guitarist and musician based in Germany.",
  sameAs: [
    // Hier später deine Social-Media-Profile ergänzen:
    // "https://www.instagram.com/...",
    // "https://www.youtube.com/...",
  ],
};
---

<AstroSeo
  title="Pascal Vorwerk – Guitarist & Musician"
  description="Official website of Pascal Vorwerk, guitarist and musician based in Germany. Discover music, projects, performances and creative work."
  canonical="https://www.pascal-vorwerk.de/"
  openGraph={{
    url: "https://www.pascal-vorwerk.de/",
    title: "Pascal Vorwerk – Guitarist & Musician",
    description:
      "Official website of Pascal Vorwerk. Discover music, projects, performances and creative work.",
    images: [
      {
        url: "https://www.pascal-vorwerk.de/og-image.jpg",
        width: 1200,
        height: 630,
        alt: "Pascal Vorwerk – Guitarist & Musician",
        type: "image/jpeg",
      },
    ],
    site_name: "Pascal Vorwerk",
    type: "website",
    locale: "en_US",
  }}
/>

<!-- Bing Webmaster Tools -->
<meta
  name="msvalidate.01"
  content="E67E794D8FB287CAC4C0BA4EC2C8F649"
/>

<script
  type="application/ld+json"
  set:html={JSON.stringify(structuredData)}
/>

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="author" content="Pascal Vorwerk" />
<meta name="color-scheme" content="light" />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />

<!-- Favicons -->
<link rel="icon" type="image/png" href="/icon.png" sizes="any" />
<link rel="apple-touch-icon" href="/icon.png" />
<link rel="manifest" href="/manifest.webmanifest" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&family=Geist+Mono:wght@100..900&display=swap"
  rel="stylesheet"
/>
