
---
import Wrapper from "../Wrapper.astro";
import Text from "../Text.astro";

const concerts = [
  {
    date: "11.10.2026",
    venue: "Galerie 21, Hamburg",
    project: "w/ Kaspar Kuoppamäki",
    detail: "Between a Partition – Finissage",
    year: "2026",
  },
  {
    date: "08.10.2026",
    venue: "Galerie 21, Hamburg",
    project: "w/ Kaspar Kuoppamäki",
    detail: "Between a Partition – Opening",
    year: "2026",
  },
  {
    date: "03.10.2026",
    venue: "mach|werk, Magdeburg",
    project: "w/ Kings Cross and Queens",
    detail: "",
    year: "2026",
  },
  {
    date: "10.07.2026",
    venue: "ELBJAZZ, Hamburg",
    project: "w/ hfmt Bigband",
    detail: "Sophia Oster // China Moses",
    year: "2026",
  },
  {
    date: "02.07.2026",
    venue: "JazzHall, Hamburg",
    project: "w/ hfmt Bigband",
    detail: "Summerfestival",
    year: "2026",
  },
];

const years = [...new Set(concerts.map((concert) => concert.year))];
---

<section class="bg-ink text-paper">
  <Wrapper class="pt-20 md:pt-32">

    <div class="flex justify-between">
      <div>
        <Text variant="meta" class="text-accent">03</Text>
        <Text variant="meta" class="mt-1 text-paper/40">Live</Text>
      </div>

      <Text variant="meta" class="max-w-32 text-right text-paper/40">
        Upcoming shows and past performances
      </Text>
    </div>

    <Text variant="displayLarge" class="my-10 md:my-14 text-accent">
      Live.
    </Text>

    {years.map((year) => (
      <div class="mb-16">
        <Text variant="meta" class="mb-6 text-accent">
          {year}
        </Text>

        <ul
          class="grid grid-cols-1 md:grid-cols-2 border-t border-l border-paper"
          role="list"
        >
          {concerts
            .filter((concert) => concert.year === year)
            .map((concert, index) => (
              <li
                class="border-b border-r border-paper"
                data-reveal
                data-reveal-delay={index * 50}
              >
                <div class="flex flex-col gap-3 px-5 py-5 min-h-28 justify-between">
                  <Text variant="meta" class="text-accent">
                    {concert.date}
                  </Text>

                  <div>
                    <Text variant="meta">
                      {concert.venue}
                    </Text>

                    <Text variant="meta" class="mt-1 text-paper/50">
                      {concert.project}
                    </Text>

                    {concert.detail && (
                      <Text variant="meta" class="mt-1 text-paper/40">
                        {concert.detail}
                      </Text>
                    )}
                  </div>
                </div>
              </li>
            ))}
        </ul>
      </div>
    ))}

    <Text variant="meta" class="mt-10 text-paper/40">
      More dates coming soon.
    </Text>



    <footer
      class="mt-20 md:mt-28 py-8 border-t border-paper flex flex-col sm:flex-row sm:justify-between sm:items-center gap-6"
    >
      <!-- Booking & Contact -->
      <Text
        tag="a"
        variant="meta"
        href="mailto:vorwwerk.pascal@posteo.org"
        class="hover:text-accent"
      >
        Booking & Contact ↗
      </Text>

      <!-- Social Media Icons -->
      <div class="flex items-center gap-5">

        <!-- Instagram -->
        <a
          href="https://www.instagram.com/pascalvks/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class="text-paper hover:text-accent transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            class="w-5 h-5 fill-current"
            aria-hidden="true"
          >
            <path d="M7.75 2h8.5A5.75 5.75 0 0 1 22 7.75v8.5A5.75 5.75 0 0 1 16.25 22h-8.5A5.75 5.75 0 0 1 2 16.25v-8.5A5.75 5.75 0 0 1 7.75 2Zm0 1.8A3.95 3.95 0 0 0 3.8 7.75v8.5a3.95 3.95 0 0 0 3.95 3.95h8.5a3.95 3.95 0 0 0 3.95-3.95v-8.5a3.95 3.95 0 0 0-3.95-3.95h-8.5ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 1.8a3.2 3.2 0 1 0 0 6.4 3.2 3.2 0 0 0 0-6.4Zm5.25-2.7a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4Z"/>
          </svg>
        </a>

        <!-- YouTube -->
        <a
          href="https://www.youtube.com/@pascal_vorwerk"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="YouTube"
          class="text-paper hover:text-accent transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            class="w-5 h-5 fill-current"
            aria-hidden="true"
          >
            <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8ZM9.6 15.6V8.4l6.3 3.6-6.3 3.6Z"/>
          </svg>
        </a>

        <!-- Spotify -->
        <a
          href="https://open.spotify.com/user/1146165881"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Spotify"
          class="text-paper hover:text-accent transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            class="w-5 h-5 fill-current"
            aria-hidden="true"
          >
            <path d="M12 0a12 12 0 1 0 0 24 12 12 0 0 0 0-24Zm5.5 17.3a.75.75 0 0 1-1.03.25c-2.82-1.72-6.37-2.11-10.54-1.15a.75.75 0 1 1-.34-1.46c4.57-1.04 8.49-.59 11.66 1.33a.75.75 0 0 1 .25 1.03Zm1.47-3.27a.94.94 0 0 1-1.29.31c-3.23-1.99-8.16-2.57-11.99-1.41a.94.94 0 1 1-.55-1.8c4.37-1.33 9.8-.69 13.52 1.6a.94.94 0 0 1 .31 1.3Zm.13-3.4C15.23 8.35 8.65 8.12 4.84 9.28a1.13 1.13 0 1 1-.66-2.16c4.38-1.33 11.65-1.07 16.25 1.66a1.13 1.13 0 0 1-1.15 1.95Z"/>
          </svg>
        </a>

      </div>

      <!-- Copyright & Impressum -->
      <div class="flex flex-wrap items-center gap-3">
        <Text variant="meta">
          © {new Date().getFullYear()} Pascal Vorwerk · Hamburg, Germany
        </Text>

        <Text
          tag="a"
          variant="meta"
          href="/impressum"
          class="text-paper/40 hover:text-accent transition-colors"
        >
          Impressum
        </Text>
      </div>

    </footer>



  </Wrapper>
</section>
